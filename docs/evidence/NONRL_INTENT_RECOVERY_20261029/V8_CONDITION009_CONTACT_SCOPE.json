  "observer_source": "import datetime\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport mujoco\n\nROOT = Path('/home/airpig/桌面/hwy/compliance_control/SII_compliance')\nBENCH = ROOT/'code/mujoco_6d_vmc_benchmark'\nEVAL = BENCH/'outputs/special_scene_frozen108_20261029_v8'\nOUTPUT = ROOT/'docs/evidence/NONRL_INTENT_RECOVERY_20261029/V8_CONDITION009_CONTACT_SCOPE.json'\nassert not OUTPUT.exists()\nsha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()\nsource = EVAL/'source/scripts/validate_office_apparatus_v5_20260917.py'\nexecution = json.loads((EVAL/'execution.json').read_text())\nrows = [r for r in execution['results'] if r['condition'].endswith('_009')]\nassert len(rows) == len({r['method'] for r in rows}) == 9\ncg = Path('/sys/fs/cgroup')/Path('/proc/self/cgroup').read_text().strip().split('::',1)[1].lstrip('/')\nresources = {n: (cg/n).read_text().strip() for n in ('memory.max','memory.swap.max','memory.events','memory.swap.current')}\nassert int(resources['memory.max']) <= 268435456 and resources['memory.swap.max'] == '0'\nresources['affinity'] = sorted(os.sched_getaffinity(0))\nassert len(resources['affinity']) == 1\nresult = []\nfor row in rows:\n    folder = Path(row['run'])\n    model_path = folder/'rollout.mjb'\n    assert sha(model_path) == row['model_sha256']\n    assert sha(folder/'AUDIT.json') == row['audit_sha256']\n    assert sha(folder/'execution.json') == row['execution_sha256']\n    audit = json.loads((folder/'AUDIT.json').read_text())\n    raw = json.loads((folder/'rollout.json').read_text())\n    model = mujoco.MjModel.from_binary_path(str(model_path))\n    def pair(names):\n        out=[]\n        for name in names or []:\n            g = int(name) if name.isdecimal() else mujoco.mj_name2id(model,mujoco.mjtObj.mjOBJ_GEOM,name)\n            assert 0 <= g < model.ngeom\n            body = int(model.geom_bodyid[g])\n            out.append(dict(recorded_name=name,geom_id=g,\n                geom_name=mujoco.mj_id2name(model,mujoco.mjtObj.mjOBJ_GEOM,g),body_id=body,\n                body_name=mujoco.mj_id2name(model,mujoco.mjtObj.mjOBJ_BODY,body)))\n        return out\n    stats=raw['stats']\n    assert audit['abort_reason'] == raw['abort_reason']\n    assert abs(audit['penetration_mm']-1000*stats['max_external_penetration_m']) < 1e-12\n    result.append(dict(method=row['method'],duration_s=row['duration_s'],abort_reason=raw['abort_reason'],\n        global_penetration_mm=1000*stats['max_penetration_m'],global_pair=pair(stats['worst_pair']),\n        external_penetration_mm=1000*stats['max_external_penetration_m'],external_pair=pair(stats['worst_external_pair']),\n        input_sha256={n:sha(folder/n) for n in ('rollout.mjb','rollout.json','AUDIT.json','execution.json')}))\nreport=dict(status='complete_condition009_saved_contact_scope_description',\n    created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),\n    observer_source=Path(__file__).read_text(), frozen_runtime_source_sha256=sha(source),\n    resources=resources, rows=result,\n    limitation='Recorded global versus external peak scopes plus geometry/body identities from the frozen MJB. '\n    'No MuJoCo integration, contact reconstruction, new substep audit, altered gate, fitting, or cause of model failure proved. '\n    'Global recorded peak includes different-body contacts; external scope excludes robot self-contact and intended target contacts.')\nwith OUTPUT.open('x') as f:\n    json.dump(report,f,ensure_ascii=False,indent=2,allow_nan=False);f.write('\\n')\nprint(OUTPUT,sha(OUTPUT))\n",
