  "observer_source": "import datetime\nimport hashlib\nimport json\nfrom pathlib import Path\nimport subprocess\nimport time\n\nROOT = Path('/home/airpig/桌面/hwy/compliance_control/SII_compliance')\nBENCH = ROOT/'code/mujoco_6d_vmc_benchmark'\nOUTPUT = ROOT/'docs/evidence/NONRL_INTENT_RECOVERY_20261029/V8_FINAL_POSTPROCESS_WAIT.json'\nIDENTITIES = [('sii-special-frozen108-v8-20261029.service', 1172675, 32623702),\n              ('sii-special-postprocess-v8-20261029.service', 1201537, 32942337)]\nassert not OUTPUT.exists()\nsamples = []\nbegan = time.monotonic()\nreason = 'bounded_observation_elapsed'\nerror = None\ntry:\n    while True:\n        row = {'utc': datetime.datetime.now(datetime.timezone.utc).isoformat()}\n        for unit, pid, ticks in IDENTITIES:\n            raw = subprocess.check_output(['systemctl','--user','show',unit,'-p','LoadState',\n                '-p','ActiveState','-p','MainPID','-p','Result','-p','ExecMainStatus',\n                '-p','InvocationID','-p','ControlGroup','-p','MemoryCurrent','-p','MemoryMax'],text=True)\n            state = dict(line.split('=',1) for line in raw.splitlines())\n            stat = Path(f'/proc/{pid}/stat')\n            try:\n                observed = int(stat.read_text().rsplit(')',1)[1].split()[19])\n            except FileNotFoundError:\n                observed = None\n            state['registered_pid_current_startticks'] = observed\n            if state['ActiveState'] == 'active':\n                assert state['LoadState']=='loaded' and state['MainPID']==str(pid) and observed==ticks\n                group = Path('/sys/fs/cgroup'+state['ControlGroup'])\n                state['memory_events'] = (group/'memory.events').read_text()\n                state['swap_current'] = (group/'memory.swap.current').read_text().strip()\n            row[unit] = state\n        ep = BENCH/'outputs/special_scene_frozen108_20261029_v8/execution.json'\n        pp = BENCH/'outputs/special_scene_postprocess_20261029_v8/execution.json'\n        eraw, praw = ep.read_bytes(), pp.read_bytes()\n        ex, post = json.loads(eraw), json.loads(praw)\n        row.update(completed=ex['completed'], evaluation_status=ex['status'],\n                   postprocess_status=post['status'], execution_sha256=hashlib.sha256(eraw).hexdigest(),\n                   postprocess_sha256=hashlib.sha256(praw).hexdigest())\n        last=ex['rows'][-1];cmd=last['command']\n        progress=Path(cmd[cmd.index('--output')+1])/'rollout.progress.json'\n        row['method']=last['method']\n        try:\n            row['progress']=json.loads(progress.read_text())\n        except (FileNotFoundError,json.JSONDecodeError) as exc:\n            row['progress_read_error']=repr(exc)\n        row['host_memory']=[s for s in Path('/proc/meminfo').read_text().splitlines()\n                            if s.startswith(('MemAvailable:','SwapTotal:','SwapFree:'))]\n        samples.append(row)\n        print(json.dumps({k:row.get(k) for k in ('utc','completed','evaluation_status',\n              'postprocess_status','method','progress')},ensure_ascii=False),flush=True)\n        if post['status']=='complete_pending_visual_review_and_archive':\n            reason='postprocessing_complete_pending_actual_review'\n            break\n        if post['status']=='failed_preserved' or ex['status'] not in ('running','complete'):\n            reason='reported_failure_requires_inspection'\n            break\n        if time.monotonic()-began >= 1800:\n            break\n        time.sleep(30)\nexcept BaseException as exc:\n    reason='observation_error_requires_repoll_not_science_restart'\n    error=repr(exc)\n    raise\nfinally:\n    result=dict(status='observer_finished_scientific_goal_not_certified',reason=reason,error=error,\n        observer_source=Path(__file__).read_text(),samples=samples,\n        limitation='Observation only. Reclaimed unit default Result/ExecMainStatus is not an original exit receipt. '\n        'Postprocessing status is not visual review, archive verification, repaired performance or goal completion.')\n    with OUTPUT.open('x') as f:\n        json.dump(result,f,ensure_ascii=False,indent=2,allow_nan=False);f.write('\\n')\n    print('observer_complete',reason,len(samples),str(OUTPUT),flush=True)\n",
