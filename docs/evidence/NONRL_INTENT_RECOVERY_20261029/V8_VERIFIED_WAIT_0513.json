  "observer_source": "import datetime\nimport hashlib\nimport json\nfrom pathlib import Path\nimport subprocess\nimport time\n\nROOT = Path('/home/airpig/桌面/hwy/compliance_control/SII_compliance')\nBENCH = ROOT/'code/mujoco_6d_vmc_benchmark'\nOUTPUT = ROOT/'docs/evidence/NONRL_INTENT_RECOVERY_20261029/V8_VERIFIED_WAIT_0513.json'\nIDENTITIES = [('sii-special-frozen108-v8-20261029.service', 1172675, 32623702),\n              ('sii-special-postprocess-v8-20261029.service', 1201537, 32942337)]\nassert not OUTPUT.exists()\nsamples = []\nbegan = time.monotonic()\nreason = 'bounded_observation_elapsed'\ntry:\n    while True:\n        row = {'utc': datetime.datetime.now(datetime.timezone.utc).isoformat()}\n        for unit, pid, ticks in IDENTITIES:\n            raw = subprocess.check_output(['systemctl', '--user', 'show', unit,\n                '-p', 'LoadState', '-p', 'ActiveState', '-p', 'MainPID',\n                '-p', 'MemoryCurrent', '-p', 'MemoryMax', '-p', 'ControlGroup'], text=True)\n            state = dict(line.split('=', 1) for line in raw.splitlines())\n            state['startticks'] = int(Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[19])\n            assert state['LoadState'] == 'loaded' and state['ActiveState'] == 'active'\n            assert state['MainPID'] == str(pid) and state['startticks'] == ticks\n            group = Path('/sys/fs/cgroup'+state['ControlGroup'])\n            state['memory_events'] = dict((a, int(b)) for a, b in\n                (line.split() for line in (group/'memory.events').read_text().splitlines()))\n            state['swap_current'] = int((group/'memory.swap.current').read_text())\n            row[unit] = state\n        raw = (BENCH/'outputs/special_scene_frozen108_20261029_v8/execution.json').read_bytes()\n        ex = json.loads(raw)\n        last = ex['rows'][-1]\n        cmd = last['command']\n        progress = Path(cmd[cmd.index('--output')+1])/'rollout.progress.json'\n        row.update(completed=ex['completed'], execution_sha256=hashlib.sha256(raw).hexdigest(),\n                   method=last['method'], condition=last['condition'],\n                   progress=json.loads(progress.read_text()) if progress.exists() else None)\n        row['host_memory'] = [line for line in Path('/proc/meminfo').read_text().splitlines()\n            if line.startswith(('MemAvailable:', 'SwapTotal:', 'SwapFree:'))]\n        samples.append(row)\n        print(json.dumps({k:row[k] for k in ('utc','completed','method','progress')}), flush=True)\n        if ex['completed'] >= 75:\n            reason = 'seventy_fifth_episode_completed'\n            break\n        if time.monotonic()-began >= 600:\n            break\n        time.sleep(30)\nexcept Exception as exc:\n    reason = 'observation_failed_requires_repoll_not_science_restart'\n    samples.append({'observation_error': repr(exc)})\n    raise\nfinally:\n    result = dict(status='verified_wait_original_science_continues' if 'failed' not in reason else 'observation_failed',\n                  reason=reason, observer_source=Path(__file__).read_text(), samples=samples,\n                  limitation='Only observer stops; no science restart, simulation, fitting or new audit. '\n                    'Runtime progress is not full matrix success or independent trajectory verification.')\n    with OUTPUT.open('x') as f:\n        json.dump(result, f, ensure_ascii=False, indent=2)\n        f.write('\\n')\n    print('observer_complete', reason, len(samples), str(OUTPUT), flush=True)\n\n",
