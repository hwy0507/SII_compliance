  "reviewer_source": "import hashlib\nimport json\nfrom pathlib import Path\nfrom datetime import datetime, timezone\nimport numpy as np\n\nrepo=Path('/home/airpig/\u684c\u9762/hwy/compliance_control/SII_compliance')\nbase=repo/'code/mujoco_6d_vmc_benchmark'\nnew=base/'outputs/special_scene_direction_collection_20261029_v9'\nold=base/'outputs/special_scene_vmc_collection_20261029_v8'\nout=repo/'docs/evidence/NONRL_INTENT_RECOVERY_20261029/V9_COMPLETED_COLLECTION_REVIEW.json'\nassert not out.exists()\ndef read(p):return json.loads(p.read_text())\ndef sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()\nplan=read(new/'COLLECTION_PLAN.json');state=read(new/'COLLECTION_PROGRESS.json')\nassert state['status']=='qualified_complete' and len(state['episodes'])==30\nassert state['plan_sha256']==sha(new/'COLLECTION_PLAN.json')\nrows=[]\nfor entry,receipt in zip(plan['episodes'],state['episodes']):\n    assert entry['id']==receipt['id'] and receipt['status']=='qualified' and receipt['returncode']==0\n    folder=Path(entry['folder']);q=read(folder/'DEMONSTRATION_QUALIFICATION.json')\n    ex=read(folder/'execution.json')\n    assert q['status']=='qualified' and all(q[k] is True for k in ('task_success','safety_valid','scene_contact_valid'))\n    assert ex['teacher_config_sha256']==plan['teacher_config_sha256']\n    assert sha(folder/'trajectory.npz')==q['trajectory_sha256']\n    row=dict(id=entry['id'],scene=entry['scene'],split=entry['split'],qualification_sha256=sha(folder/'DEMONSTRATION_QUALIFICATION.json'),\n        trajectory_sha256=q['trajectory_sha256'],metrics=q['metrics'])\n    if entry['scene'] in ('rod','corner'):\n        previous=old/entry['id']/entry['scene']/'trajectory.npz'\n        with np.load(folder/'trajectory.npz',allow_pickle=False) as a,np.load(previous,allow_pickle=False) as b:\n            assert set(a.files)==set(b.files)\n            for name in a.files:np.testing.assert_array_equal(a[name],b[name])\n            row['unchanged_actor_trace']=dict(frames=len(a['time']),fields=list(a.files),\n                previous_trajectory_sha256=sha(previous),exact_array_equality=True)\n    if entry['scene']=='rod':\n        audit=read(folder/'ROD_YIELD_REJOIN_AUDIT_V3.json')\n        assert audit['status']=='passed' and all(audit['checks'].values())\n        assert audit['hand_contact_first_s']<=audit['yield_start_s']<=audit['pass_s']<=audit['rejoin_confirmed_s']<audit['retract_start_s']\n        row['rod_behavior']=dict(audit_sha256=sha(folder/'ROD_YIELD_REJOIN_AUDIT_V3.json'),\n            confirmed_rejoin_s=audit['rejoin_confirmed_s'],withdrawal_s=audit['retract_start_s'],\n            margin_s=audit['retract_start_s']-audit['rejoin_confirmed_s'])\n    rows.append(row)\nresult=dict(status='all30_qualified_and20_unchanged_scene_actor_traces_verified',created_utc=datetime.now(timezone.utc).isoformat(),\n    plan_sha256=sha(new/'COLLECTION_PLAN.json'),progress_sha256=sha(new/'COLLECTION_PROGRESS.json'),\n    reviewer_source=Path(__file__).read_text(),rows=rows,\n    limitation='Qualification receipts were generated by original substep/actor audits. This review hashes small receipts and trajectories and compares saved actor-rate arrays for all20 unchanged rod/corner identities; it does not reintegrate dynamics or evaluate students.')\nwith out.open('x') as stream:json.dump(result,stream,indent=2);stream.write('\\n')\nprint('reviewed',len(rows),'qualified; unchanged20 frames',sum(r.get('unchanged_actor_trace',{}).get('frames',0) for r in rows),sha(out),flush=True)\n",
