  "reproduction_command": "OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 /home/airpig/桌面/hwy/compliance_control/.venv-sii-local-rl/bin/python - <<'PY'\nimport ast,hashlib,json,tarfile\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nimport numpy as np\nbase=Path('.').resolve();collection=base/'outputs/special_scene_vmc_collection_20261028_v5';training=base/'outputs/special_scene_retrain_readout05_20261028_v1';test=base/'outputs/special_scene_frozen108_readout05_20261028_v1'\ndef read(p):return json.loads(p.read_text())\ndef sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()\ndef node(source,name):return ast.dump(next(n for n in ast.parse(source).body if isinstance(n,(ast.FunctionDef,ast.ClassDef)) and n.name==name),include_attributes=False)\nkeys={'scripts/haptic_vmc_teacher_20260916.py':['JointLoadObserver','equivalent_tool_wrench'],'scripts/run_benchmark.py':['body_twist','body_jacobian','so3_log'],'scripts/wbc_velocity_residual_core.py':['VelocityResidualActionFilter']}\nplan=read(collection/'COLLECTION_PLAN.json');lineage=[];variants={}\nfor entry in plan['episodes']:\n folder=Path(entry['folder']);h=read(folder/'SOURCE_HASHES.json');ex=read(folder/'execution.json')\n assert sha(base/'tools/run_video_reference_vmc_20261028.py')==ex['wrapper_sha256']\n for path in keys:variants.setdefault((path,h[path]),folder/'source.tar.gz')\n lineage.append(dict(id=entry['id'],source_archive_sha256=sha(folder/'source.tar.gz'),manifest_sha256=sha(folder/'SOURCE_HASHES.json'),wrapper_sha256=ex['wrapper_sha256']))\ncomparisons=[]\nfor (path,digest),archive in sorted(variants.items()):\n with tarfile.open(archive) as t:content=t.extractfile(path).read()\n assert hashlib.sha256(content).hexdigest()==digest\n frozen=(test/'source'/path).read_bytes()\n for name in keys[path]:\n  assert node(content,name)==node(frozen,name),(path,name)\n comparisons.append(dict(path=path,collection_sha256=digest,test_sha256=sha(test/'source'/path),ast_identical_symbols=keys[path]))\nfields=[*range(14,17),*range(20,23),*range(26,29),*range(39,48)]\nwith np.load(training/'data/training_data.npz',allow_pickle=False) as z: train=z['observation'][z['train']][:,fields]\nlo,hi=train.min(0),train.max(0);span=np.maximum(hi-lo,1e-6)\nreport=read(test/'REPORT.json');rows=report['rows'][:5];assert len(rows)==5\nresults=[]\nfor row in rows:\n run=Path(row['run']);assert sha(run/'rollout.npz')==row['trace_sha256']\n summary=read(run/'rollout.json');assert summary['observer_settings']=={'friction_velocity_scale':.005,'filter_tau_s':.04,'truth_in_observer':False}\n with np.load(run/'rollout.npz',allow_pickle=False) as z:\n  full=z['observation'];time=z['neuron_time'];obs=full[:,fields]\n  assert full.shape[1]==48 and np.isfinite(full).all()\n  out=(obs<lo-1e-12)|(obs>hi+1e-12)\n  normalized=np.maximum(lo-obs,obs-hi).clip(min=0)/span\n  early=time<2.\n  results.append(dict(method=row['method'],condition=row['condition'],trace_sha256=row['trace_sha256'],observations=len(obs),task_success=row['task_success'],strict_success=row['strict_success'],any_field_outside_train_minmax_fraction=float(out.any(1).mean()),first2s_any_field_outside_train_minmax_fraction=float(out[early].any(1).mean()),by_field_outside_fraction=out.mean(0).tolist(),by_field_max_range_normalized_excess=normalized.max(0).tolist(),test_min=obs.min(0).tolist(),test_max=obs.max(0).tolist()))\nprint(json.dumps(dict(created_utc=datetime.now(timezone.utc).isoformat(),status='source_semantics_review_and_descriptive_prefix_range_check',collection_lineage=lineage,shared_math_ast_checks=comparisons,dataset_sha256=sha(training/'data/training_data.npz'),model_lock_sha256=sha(test/'INPUT_MODEL_LOCK.json'),selected_fields=fields,field_groups={'14:17':'world commanded linear velocity, m/s','20:23':'world target-minus-hand position error, m','26:29':'world commanded-minus-measured linear velocity, m/s','39:42':'estimated world tool force, N','42:45':'estimated world tool moment, Nm','45:48':'commanded path unit 