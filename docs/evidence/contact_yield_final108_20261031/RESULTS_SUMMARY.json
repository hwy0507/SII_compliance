    "strict": "Task plus frozen safety checks plus required scene-specific contact/rod behavior.",
    "spt": "T_ref / max(completion_time, T_ref), only where Task and Strict are both true; global T_ref is the shortest such completion time across all 108 cells.",
    "peak_torque": "Mean per-episode maximum absolute torque over all joints and saved physics substeps; all episodes remain in denominator.",
    "human_comfort": "NA because no human-force/contact channel was measured. Disturbance contact proxy is reported separately in the full review.",
    "machine_compliance": "Full episode, finite telemetry, no external penetration >0.2 mm, and no actuator torque-limit excess."
  }
}
